<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear /> drops any feed inherited from a machine- or user-level NuGet.config, so a restore
       resolves the same packages on a dev box as it does on the CI runner. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
