<Project>

    <!--
        Imported automatically by every project under src/. A property set in a .csproj is evaluated
        after this file and therefore wins, which is how IK.Imager.Api.Contract keeps its own
        netstandard2.1 target framework.
    -->

    <PropertyGroup Label="Language">
        <TargetFramework>net10.0</TargetFramework>
        <!-- Explicit: on netstandard2.1 the default LangVersion is still C# 7.3. -->
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Label="Build hygiene">
        <!-- Report known vulnerabilities in transitive packages, not just direct references. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <!-- Normalises paths embedded in the assembly; GitHub Actions sets CI=true. -->
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

</Project>
